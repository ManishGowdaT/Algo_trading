PORT=5000
MONGO_URI=mongodb://localhost:27017/algo-trading
# Local-only database seeding requires explicit opt-in and credentials.
ALLOW_DATABASE_SEED=false
SEED_EMAIL=
SEED_PASSWORD=
# Generate a unique random value for this deployment; do not reuse the placeholder.
JWT_SECRET=replace-with-a-long-random-value
# Optional separate keys; if set, use independently generated random values.
# Legacy JWT_SECRET verification remains enabled during migration.
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90
JWT_REFRESH_EXPIRES_IN=90d
JWT_REFRESH_COOKIE_EXPIRES_IN=90
# Keep lax for same-site frontend/API deployments. Use none only for cross-site HTTPS deployments.
AUTH_REFRESH_COOKIE_SAME_SITE=lax
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_REGISTER_MAX_ATTEMPTS=5
# Authenticated API request budgets (per user, per Node process).
# Keep market-data limits above the dashboard's three index requests every 2 seconds.
API_RATE_LIMIT_WINDOW_MS=60000
ANGEL_LOGIN_RATE_LIMIT_WINDOW_MS=900000
ANGEL_LOGIN_MAX_ATTEMPTS=10
# Generate a 32-byte random key, base64 encode it, and store it in deployment
# secrets. Keep old key IDs during rotation until existing credentials are re-encrypted.
BROKER_CREDENTIAL_ACTIVE_KEY_VERSION=v1
BROKER_CREDENTIAL_ENCRYPTION_KEYS={"v1":"replace-with-base64-encoded-32-byte-random-key"}
BROKER_READ_MAX_REQUESTS=300
MARKET_READ_MAX_REQUESTS=600
ORDER_PLACEMENT_MAX_REQUESTS=60
STRATEGY_START_MAX_REQUESTS=30
STRATEGY_READ_MAX_REQUESTS=240
TRADE_READ_MAX_REQUESTS=120
TRADE_WRITE_MAX_REQUESTS=120
BUFFER_SIZE=100
PROBE_INITIAL_DELAY_MS=100
PROBE_RETRY_INTERVAL_MS=150
PROBE_MAX_ATTEMPTS=4
IDLE_TIMEOUT_MS=900000
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:40
MARKET_TIMEZONE=Asia/Kolkata
ANGEL_ONE_API_BASE=http://localhost:8000
# Upstox OAuth is used only by the spreads market-data workflow. Register the
# redirect URI verbatim in your Upstox developer app. Tokens are held in memory.
# Use the integrated Node callback below, not the old port-8001 /auth/callback.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:5000/api/v1/spreads/upstox/callback
UPSTOX_FRONTEND_RETURN_URL=http://localhost:5173/spreads
# Start in explicit fixture mode until Upstox F&O market-data access is active.
SPREADS_DATA_MODE=fixtures
SPREADS_PYTHON_TIMEOUT_MS=60000
# Set true only when Node and Python communicate over a private isolated network.
ANGEL_ONE_PRIVATE_NETWORK=false
API_TIMEOUT_MS=5000
PYTHON_COLD_START_TIMEOUT_MS=60000
# Use the same generated value in angel-one/.env. Do not reuse JWT_SECRET.
INTERNAL_SERVICE_KEY=replace-with-the-same-long-random-value-used-by-angel-one
LOG_LEVEL=info
ALERT_WEBHOOK_URL=
